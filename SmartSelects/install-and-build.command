#!/bin/bash
set -euo pipefail

# SmartSelects FCP — offline native workflow extension. No internet calls.
# Works without opening Xcode's UI, but Xcode command line tools must be installed.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORK="$(mktemp -d "${TMPDIR:-/tmp/}smartselects.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
cd "$WORK"

echo "SmartSelects — bouw de native Final Cut Pro extensie"
if ! command -v xcodebuild >/dev/null 2>&1; then
  echo "Xcode ontbreekt. Een Mac-build vereist Xcode (Apple App Store)."
  if [[ "${CI_BUILD:-0}" != "1" ]]; then read -r -p "Druk op Enter om af te sluiten..." _; fi
  exit 1
fi

cat > source.b64 <<'SMARTSELECTS_PAYLOAD'

SMARTSELECTS_PAYLOAD
base64 -D -i source.b64 -o source.tar.gz
mkdir src
cd src
tar xzf ../source.tar.gz

# Normaliseer dubbele Xcode-quoting van de projectgenerator.
python3 - <<'PY'
from pathlib import Path
p = Path("SmartSelects.xcodeproj/project.pbxproj")
s = p.read_text()
s = s.replace(r'\\"-O\\"', '-O')
s = s.replace(r'\\"Apple Development\\"', 'Apple Development')
s = s.replace(r'\\"$(inherited) @executable_path/../Frameworks\\"', '$(inherited) @executable_path/../Frameworks')
s = s.replace(r'\\"$(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks\\"', '$(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks')
p.write_text(s)
PY

xcodebuild -project SmartSelects.xcodeproj -target SmartSelectsHost \
  -configuration Release -sdk macosx SYMROOT="$WORK/build" \
  ARCHS="arm64 x86_64" ONLY_ACTIVE_ARCH=NO CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build
APP="$WORK/build/Release/SmartSelects.app"
if [ ! -d "$APP/Contents/PlugIns/SmartSelectsFCP.appex" ]; then
  echo "Build mislukt: de Final Cut Pro-extensie ontbreekt."
  exit 1
fi
codesign --force --deep --sign - --timestamp=none "$APP"

if [[ "${CI_BUILD:-0}" == "1" ]]; then
  mkdir -p "${GITHUB_WORKSPACE:-$SCRIPT_DIR}/dist"
  ditto -c -k --sequesterRsrc --keepParent "$APP" "${GITHUB_WORKSPACE:-$SCRIPT_DIR}/dist/SmartSelects-FCP-macOS.zip"
  echo "Build klaar: dist/SmartSelects-FCP-macOS.zip"
else
  echo "Installeer SmartSelects.app in Programma's..."
  ditto "$APP" /Applications/SmartSelects.app
  open /Applications/SmartSelects.app
  echo "Installatie gereed. Start Final Cut Pro opnieuw en open Extensies → SmartSelects FCP."
  read -r -p "Druk op Enter om te sluiten..." _
fi

